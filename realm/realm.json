      "emailVerified": true,
      "attributes": {},
      "credentials": [
        {
          "type": "password",
          "value": "secret",
          "temporary": false
        }
      ],
      "realmRoles": []
    }
  ],
  "clients": [
    {
      "clientId": "listings-api",
      "name": "Listings API client",
      "description": "Confidential client used by scripts (curl / Postman) to get tokens with the password grant",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "secret": "listings-api-secret",
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": [
        "basic",
        "roles",
        "profile",
        "email",
        "acr"
      ],
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "audience-listings-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "listings-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "listings-spa",
      "name": "Listings SPA (bonus)",
      "enabled": true,
      "description": "Public client used by the bonus SPA",
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:5500/*"
      ],
      "webOrigins": [
        "+",
        "http://localhost:3000",
        "http://localhost:5500"
      ],
      "defaultClientScopes": [
        "basic",
        "roles",
        "profile",
        "email",
        "acr"
      ],
      "protocolMappers": [
        {
          "name": "audience-listings-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "listings-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ]
}
